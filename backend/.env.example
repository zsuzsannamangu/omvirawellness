# PostgreSQL
DATABASE_URL=postgres://youruser:yourpass@host:5432/yourdbname?sslmode=require

# App Port
PORT=4000

# Set this to "production" in deployment environments
NODE_ENV=development

# SendGrid Email Service
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=noreply@omvirawellness.com

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
BACKEND_URL=http://localhost:4000
SESSION_SECRET=your_random_secret_here
FRONTEND_URL=http://localhost:3000  # For local development, use https://yourdomain.com for production
